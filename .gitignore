# Large/raw data never lives in the repo
*.idat
*.idat.gz
*.bam
*.fastq.gz
*.fq.gz
*.tar
/raw/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
results/phase3/raw/

# data/ holds only download scripts and manifests; the downloads themselves live in
# $CFDNA_DATA (default: ../cfdna-methylation-lod-data). Guard against copies landing here.
data/*
!data/*.sh
!data/checksums.sha256
!data/README.md

# Per-run raw outputs (large; regenerated by the Slurm scripts)
results/*/raw*/
results/*/perm/
*.parquet
