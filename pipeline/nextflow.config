// Phase 5 pipeline settings. Paths default to $CFDNA_DATA (the data directory outside the repo).
def data = System.getenv('CFDNA_DATA') ?: "${projectDir}/../../cfdna-methylation-lod-data"

params {
    samples       = "${projectDir}/samples/phase5_samples.tsv"
    blocks        = "${projectDir}/markers/phase5_blocks.bed"
    offmarker     = "${projectDir}/markers/phase5_offmarker.bed"
    ena_report    = "${data}/sra/PRJNA929650_ena_filereport.tsv"
    only_runs     = null            // comma-separated subset of runs, for tests
    input_bams    = null            // start from duplicate-marked BAMs (smoke test)
    input_fastq   = null            // local paired FASTQ glob, e.g. 'dir/*_{1,2}.fastq.gz' (test_fastq)
    keep_fastq    = false           // default: delete a run's downloaded and trimmed FASTQ once its BAM passes BAM_CHECK
    delete_input_fastq = false      // also delete local --input_fastq files (they may be the only copy)
    reuse_bams    = true            // start a run from its published BAM when one exists (FASTQ may be gone)

    // Spike source: HCT116 WGBS, GSM8156741 (pre-registered).
    spike_run     = 'SRR28401050'
    spike_urls    = 'ftp.sra.ebi.ac.uk/vol1/fastq/SRR284/050/SRR28401050/SRR28401050_1.fastq.gz;ftp.sra.ebi.ac.uk/vol1/fastq/SRR284/050/SRR28401050/SRR28401050_2.fastq.gz'
    spike_pairs   = 20000000

    // fastp clips (pre-registered): Adaptase tail at the R2 5' end, R1 3' end, then a length cap.
    clip_r2_5     = 15
    clip_r1_3     = 15
    clip_r2_3     = 0
    max_len       = 85

    fastq_dir     = "${data}/sra/fastq"
    ref_dir       = "${data}/ref/hg38"
    fasta_name    = 'genome.fa'
    conversion_chrom = 'chr21'
    outdir        = "${data}/phase5"

    // wgbstools v0.3.0: source tree, its Python, and an initialised genome directory.
    // wgbs_ref = null makes the pipeline run `wgbstools init_genome` on the FASTA.
    wgbs_home     = "${data}/tools/wgbs_tools-0.3.0"
    wgbs_python   = "${data}/tools/wgbs_tools-0.3.0/.venv/bin/python"
    wgbs_genome   = 'hg38'
    wgbs_ref      = "${data}/tools/wgbs_tools-0.3.0/references/hg38"

    // Tool environment for the conda profile (see envs/phase5.explicit.txt).
    tool_env      = "${data}/tools/p5env"
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 2
    memory = '4 GB'
    time = '2h'
    withLabel: fetch        { cpus = 1; memory = '2 GB'; time = '6h'; maxForks = 3 }
    withLabel: fastp        { cpus = 8; memory = '8 GB'; time = '2h' }
    withLabel: bwameth      { cpus = 16; memory = '40 GB'; time = '12h' }
    withLabel: methyldackel { cpus = 4; memory = '8 GB'; time = '4h' }
    withLabel: wgbstools    { cpus = 4; memory = '16 GB'; time = '4h' }
    withLabel: samtools     { cpus = 1; memory = '2 GB'; time = '2h' }
    withName: BWAMETH_INDEX { cpus = 2; memory = '40 GB'; time = '16h' }
}

def biocontainer = [
    fastp       : 'fastp:0.23.4--hadf994f_2',
    bwameth     : 'bwameth:0.2.10--pyh106432d_0',
    methyldackel: 'methyldackel:0.6.1--he4a0461_7',
    samtools    : 'samtools:1.21--h50ea8bc_0',
]

profiles {
    slurm {
        process.executor = 'slurm'
        process.queue = System.getenv('NXF_SLURM_QUEUE')   // the cluster partition
        executor.queueSize = 8
        executor.submitRateLimit = '10/1min'
    }
    // Pinned micromamba environment with the same tool versions as the containers.
    // Used on the HPC when containers cannot run (see pipeline/README.md).
    conda {
        conda.enabled = true
        conda.useMicromamba = true
        process.conda = params.tool_env
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        process {
            withLabel: fastp        { container = "https://depot.galaxyproject.org/singularity/${biocontainer.fastp}" }
            withLabel: bwameth      { container = "https://depot.galaxyproject.org/singularity/${biocontainer.bwameth}" }
            withLabel: methyldackel { container = "https://depot.galaxyproject.org/singularity/${biocontainer.methyldackel}" }
            withLabel: samtools     { container = "https://depot.galaxyproject.org/singularity/${biocontainer.samtools}" }
            withLabel: wgbstools    { container = 'docker://cfdna-wgbstools:0.3.0' }
        }
        params.wgbs_home = '/opt/wgbstools'
        params.wgbs_python = 'python'
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            withLabel: fastp        { container = "quay.io/biocontainers/${biocontainer.fastp}" }
            withLabel: bwameth      { container = "quay.io/biocontainers/${biocontainer.bwameth}" }
            withLabel: methyldackel { container = "quay.io/biocontainers/${biocontainer.methyldackel}" }
            withLabel: samtools     { container = "quay.io/biocontainers/${biocontainer.samtools}" }
            // Built from pipeline/containers/wgbstools/Dockerfile.
            withLabel: wgbstools    { container = 'cfdna-wgbstools:0.3.0' }
        }
        params.wgbs_home = '/opt/wgbstools'
        params.wgbs_python = 'python'
    }
    // Written for portability; not run in this project. Needs the containers above in a
    // registry the Batch queue can pull from, and S3 paths for every params path.
    awsbatch {
        process.executor = 'awsbatch'
        process.queue = System.getenv('NXF_AWSBATCH_QUEUE') ?: 'default'
        aws.region = System.getenv('AWS_REGION') ?: 'us-west-2'
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
    }
    // FASTQ-deletion test: FASTQ made from the bundled BAM by pipeline/tests/fastq_cleanup_test.sh,
    // aligned to the bundled 1 Mb slice, then deleted after BAM_CHECK.
    test_fastq {
        params.input_fastq = "${launchDir}/results_test_fastq/fastq/*_{1,2}.fastq.gz"
        params.ref_dir = "${launchDir}/results_test_fastq/ref"
        params.blocks = "${projectDir}/tests/data/test_blocks.bed"
        params.offmarker = "${projectDir}/tests/data/test_offmarker.bed"
        params.conversion_chrom = 'chr21'
        params.wgbs_genome = 'test_chr21'
        params.wgbs_ref = null
        params.outdir = "${launchDir}/results_test_fastq"
        process {
            cpus = 1
            memory = '2 GB'
            withLabel: fastp { cpus = 1; memory = '2 GB' }
            withLabel: bwameth { cpus = 2; memory = '4 GB' }
            withLabel: wgbstools { cpus = 1; memory = '2 GB' }
            withLabel: methyldackel { cpus = 1; memory = '2 GB' }
            withName: BWAMETH_INDEX { cpus = 1; memory = '4 GB' }
        }
    }
    // Smoke test on a tiny bundled BAM: HCT116 reads on a 1 Mb slice of hg38 chr21.
    test {
        params.input_bams = "${projectDir}/tests/data/HCT116_test.md.bam"
        params.ref_dir = "${projectDir}/tests/data/ref"
        params.blocks = "${projectDir}/tests/data/test_blocks.bed"
        params.offmarker = "${projectDir}/tests/data/test_offmarker.bed"
        params.conversion_chrom = 'chr21'
        params.wgbs_genome = 'test_chr21'
        params.wgbs_ref = null
        params.outdir = 'results_test'
        process {
            cpus = 1
            memory = '2 GB'
            withLabel: wgbstools { cpus = 1; memory = '2 GB' }
            withLabel: methyldackel { cpus = 1; memory = '2 GB' }
        }
    }
}

manifest {
    name = 'cfdna-methylation-lod/phase5'
    description = 'Read-level in-silico mixing for cfDNA methylation detection limits'
    nextflowVersion = '>=24.04'
}
